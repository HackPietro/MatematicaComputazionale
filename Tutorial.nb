Cell[BoxData[
 DynamicModuleBox[{Ruffini`Private`polinomioGenerato$$ = 16 - 
  8 $CellContext`x + $CellContext`x^2, Ruffini`Private`gradoScelto$$ = 2, 
  Ruffini`Private`seed$$ = 10, Ruffini`Private`seedMessage$$ = "", 
  Ruffini`Private`inputErrorMessage$$ = "", Ruffini`Private`radice$$ = Null, 
  Ruffini`Private`polinomioInput$$ = Null, Ruffini`Private`feedbackMessage$$ =
   Style["In attesa di input utente", 
   GrayLevel[0.5], 16, Bold], Ruffini`Private`x$$ = $CellContext`x}, 
  TagBox[GridBox[{
     {
      TemplateBox[{
        TagBox[
         GridBox[{{
            StyleBox[
            "\"Esercizio:\"", StripOnInput -> False, FontWeight -> Bold]}, {
            InputFieldBox[
             Dynamic[Ruffini`Private`seed$$], ImageSize -> 50]}, {
            DynamicBox[
             ToBoxes[
              Style[Ruffini`Private`seedMessage$$, 12, Red], StandardForm], 
             ImageSizeCache -> {0., {0., 5.8828125}}]}}, DefaultBaseStyle -> 
          "Column", GridBoxAlignment -> {"Columns" -> {{Left}}}, 
          GridBoxItemSize -> {
           "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], "Column"], 
        TemplateBox[{20}, "Spacer1"], 
        TagBox[
         GridBox[{{
            StyleBox["\"Grado:\"", Bold, StripOnInput -> False]}, {
            PopupMenuBox[
             Dynamic[Ruffini`Private`gradoScelto$$], {
             2 -> "\"Grado 2\"", 3 -> "\"Grado 3\"", 4 -> "\"Grado 4\""}]}}, 
          GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
          "Column", 
          GridBoxItemSize -> {
           "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], "Column"], 
        TemplateBox[{20}, "Spacer1"], 
        ButtonBox[
        "\"Genera Esercizio\"", ButtonFunction :> 
         If[Ruffini`Private`seed$$ === Null, Ruffini`Private`seedMessage$$ = 
           "Seleziona numero esercizio", 
           If[
            IntegerQ[Ruffini`Private`seed$$], 
            SeedRandom[Ruffini`Private`seed$$]; 
            Ruffini`Private`polinomioGenerato$$ = 
             Ruffini`Private`generatePolynom[Ruffini`Private`gradoScelto$$]; 
            Ruffini`Private`polinomioInput$$ = Null; 
            Ruffini`Private`radice$$ = Null; 
            Ruffini`Private`feedbackMessage$$ = 
             Style["In attesa di input utente", Gray, 16, Bold]; 
            Ruffini`Private`inputErrorMessage$$ = ""; 
            Ruffini`Private`seedMessage$$ = "", Ruffini`Private`seedMessage$$ = 
            "Inserire un intero"]], Method -> "Queued", 
         ImageSize -> {150, 40}, Appearance -> "FramedPalette", Evaluator -> 
         Automatic], 
        TemplateBox[{20}, "Spacer1"], 
        ButtonBox[
        "\"Verifica Esercizio\"", ButtonFunction :> 
         Which[Ruffini`Private`polinomioGenerato$$ === "", 
           Ruffini`Private`feedbackMessage$$ = 
           Style["Inserire prima il numero dell'esercizio e generarlo ", 
             Orange, 16, Bold], 
           Or[
           Ruffini`Private`radice$$ === Null, 
            Ruffini`Private`polinomioInput$$ === Null], 
           Ruffini`Private`inputErrorMessage$$ = 
            Style["Dati Mancanti", Red, 16]; 
           Ruffini`Private`feedbackMessage$$ = 
            Style["In attesa di input utente", Gray, 16, Bold], 
           Not[
            IntegerQ[Ruffini`Private`radice$$]], 
           Ruffini`Private`inputErrorMessage$$ = 
            Style["La radice deve essere intera", Red, 16, Bold]; 
           Ruffini`Private`feedbackMessage$$ = 
            Style["In attesa di input utente", Gray, 16, Bold], 
           And[
           Simplify[
             Ruffini`Private`polinomioInput$$ - 
              Ruffini`Private`polinomioGenerato$$/(Ruffini`Private`x$$ - 
              Ruffini`Private`radice$$)] === 0, 
            ReplaceAll[
             Ruffini`Private`polinomioGenerato$$, Ruffini`Private`x$$ -> 
              Ruffini`Private`radice$$] == 0], 
           Ruffini`Private`inputErrorMessage$$ = ""; 
           Ruffini`Private`feedbackMessage$$ = 
            Style["\[Checkmark] Bravissimo/a! Tutto corretto!", Green, 16, 
              Bold], ReplaceAll[
            Ruffini`Private`polinomioGenerato$$, Ruffini`Private`x$$ -> 
             Ruffini`Private`radice$$] == 0, 
           Ruffini`Private`inputErrorMessage$$ = ""; 
           Ruffini`Private`feedbackMessage$$ = 
            Style["La radice \[EGrave] corretta ma non il quoziente", Orange, 
              16, Bold], True, Ruffini`Private`feedbackMessage$$ = 
           Style["La radice non \[EGrave] corretta ", Red, 16, Bold]], Method -> 
         "Queued", ImageSize -> {150, 40}, Appearance -> "FramedPalette", 
         Evaluator -> Automatic]},
       "RowDefault"]},
     {
      TemplateBox[{10},
       "Spacer1"]},
     {
      PanelBox[
       DynamicBox[ToBoxes[
         Style[
          If[
          Ruffini`Private`polinomioGenerato$$ === "", "Clicca per generare", 
           TraditionalForm[Ruffini`Private`polinomioGenerato$$]], 26], 
         StandardForm],
        ImageSizeCache->{
         135.6352676340739, {0.3173828125, 23.534814996272324`}}],
       Background->GrayLevel[1],
       FrameMargins->20,
       ImageSize->All]},
     {
      TemplateBox[{10},
       "Spacer1"]},
     {
      TagBox[GridBox[{
         {
          TemplateBox[{
            TagBox[
             GridBox[{{
                StyleBox[
                "\"Inserisci la radice:\"", StripOnInput -> False, FontWeight -> 
                 Bold]}, {
                InputFieldBox[
                 Dynamic[Ruffini`Private`radice$$]]}}, DefaultBaseStyle -> 
              "Column", GridBoxAlignment -> {"Columns" -> {{Left}}}, 
              GridBoxItemSize -> {
               "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
             "Column"], 
            TemplateBox[{20}, "Spacer1"], 
            TagBox[
             GridBox[{{
                StyleBox[
                "\"Quoziente:\"", StripOnInput -> False, FontWeight -> 
                 Bold]}, {
                InputFieldBox[
                 Dynamic[Ruffini`Private`polinomioInput$$], Expression, 
                 ImageSize -> 250]}}, DefaultBaseStyle -> "Column", 
              GridBoxAlignment -> {"Columns" -> {{Left}}}, 
              GridBoxItemSize -> {
               "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
             "Column"]},
           "RowDefault"]},
         {
          TemplateBox[{20},
           "Spacer1"]},
         {
          
          DynamicBox[ToBoxes[
           Ruffini`Private`inputErrorMessage$$, StandardForm],
           ImageSizeCache->{0., {0., 6.373046875}}]}
